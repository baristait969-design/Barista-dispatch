rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.email == 'baristait969@gmail.com'
      );
    }

    function isEditorOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserData().role == 'editor'
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection - user profiles and credentials
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || !exists(/databases/$(database)/documents/users/$(userId));
    }

    // Central Kitchen Inventory batches
    match /inventory/{batchId} {
      allow read: if true;
      allow write: if isAuthenticated() || isEditorOrAdmin();
    }

    // Batch Audit Logs
    match /batch_logs/{logId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Retail Outlets (Barista coffee branches)
    match /outlets/{outletId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // HACCP Dispatch Logs (BCL/REC/HACCP/32)
    match /dispatch_logs/{dispatchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Logistics Drivers & Chilled Vehicles
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Fallback rule
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
